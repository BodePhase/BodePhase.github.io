{
  "name": "bodephase-portfolio",
  "description": "Personal Website Portfolio of Massimiliano Favetta",
  "version": "2.0.0",
  "author": "Massimiliano Favetta",
  "repository": {
    "type": "git",
    "url": "https://github.com/BodePhase/BodePhase.github.io"
  },
  "keywords": [
    "gatsby",
    "react",
    "portfolio"
  ],
  "license": "MIT",
  "browserslist": [
    "> 0.25%",
    "not dead"
  ],
  "scripts": {
    "develop": "mkdir -p .cache && gatsby develop",
    "start": "npm run develop",
    "build": "mkdir -p .cache && gatsby build",
    "serve": "gatsby serve",
    "clean": "gatsby clean && mkdir -p .cache",
    "format": "prettier --write \"src/**/*.{js,jsx,json,md}\""
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-keywords": "^5.1.0",
    "babel-plugin-styled-components": "^2.1.4",
    "framer-motion": "^11.11.17",
    "gatsby": "^5.13.7",
    "gatsby-plugin-image": "^3.13.1",
    "gatsby-plugin-manifest": "^5.13.1",
    "gatsby-plugin-react-helmet": "^6.16.0",
    "gatsby-plugin-robots-txt": "^1.8.0",
    "gatsby-plugin-sharp": "^5.13.1",
    "gatsby-plugin-sitemap": "^6.13.1",
    "gatsby-plugin-styled-components": "^6.13.1",
    "gatsby-remark-code-titles": "^1.1.0",
    "gatsby-remark-external-links": "^0.0.4",
    "gatsby-remark-images": "^7.13.1",
    "gatsby-remark-prismjs": "^7.13.1",
    "gatsby-source-filesystem": "^5.13.1",
    "gatsby-transformer-remark": "^6.13.1",
    "gatsby-transformer-sharp": "^5.13.1",
    "lodash": "^4.17.21",
    "prismjs": "^1.29.0",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet": "^6.1.0",
    "styled-components": "^5.3.11"
  },
  "devDependencies": {
    "prettier": "^3.3.3"
  },
  "engines": {
    "node": ">=20.0.0 <25.0.0",
    "npm": ">=10.0.0"
  }
}
